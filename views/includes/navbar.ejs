<nav class="navbar-modern">
  <div class="container">
    <div class="navbar-content">

      <!-- Brand -->
      <div class="navbar-brand">
        <a href="/home" class="brand-link">
          <div class="brand-mark">
            <!-- Organic Abstract Symbol for Hireska -->
            <div class="brand-shape-main"></div>
            <div class="brand-shape-accent"></div>
          </div>
          <div class="brand-text-group">
            <span class="brand-name">Hireska</span>
          </div>
        </a>
      </div>

      <!-- Navigation Links -->
      <div class="navbar-links" id="navbarLinks">
        <a href="/home" class="nav-link">
          <i class="fa-solid fa-house-chimney nav-link-icon"></i>
          <span>Home</span>
        </a>
        <a href="/jobs" class="nav-link">
          <i class="fa-solid fa-briefcase nav-link-icon"></i>
          <span>Jobs</span>
        </a>
        <a href="/questions/list" class="nav-link">
          <i class="fa-solid fa-code nav-link-icon"></i>
          <span>Questions</span>
        </a>
        <a href="/recruiter/register" class="nav-link">
          <i class="fa-solid fa-building nav-link-icon"></i>
          <span>Employers</span>
        </a>

        <% if (user) { %>
          <a href="/chats/chatbox/<%= user._id %>" class="nav-link nav-link-special">
            <i class="fa-solid fa-comment-dots nav-link-icon"></i>
            <span>Messages</span>
          </a>

          <a href="/users/profile" class="nav-link-profile-pill">
            <span class="profile-avatar"><%= (user.username || 'U')[0].toUpperCase() %></span>
            <span><%= user.username || 'Profile' %></span>
          </a>

          <a href="/users/logout" class="btn btn-sm btn-outline">
            Logout
          </a>
        <% } else { %>
          <a href="/users/login" class="btn btn-sm btn-secondary">Login</a>
          <a href="/users/register" class="btn btn-sm btn-primary">Get Started <i class="fa-solid fa-arrow-right ml-1"></i></a>
        <% } %>
      </div>

      <!-- Mobile Toggle -->
      <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle menu">
        <i class="fa-solid fa-bars"></i>
      </button>

    </div>
  </div>
</nav>

<style>
/* ===============================================
   NAVBAR — HIRESKA EDITION
   =============================================== */
.navbar-modern {
  position: sticky;
  top: 0;
  z-index: 1020;
  background: rgba(253, 251, 247, 0.95); /* Ivory background */
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-color);
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72px; /* Taller, more spacious */
  gap: 16px;
}

/* Brand */
.brand-link {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  transition: opacity 0.2s ease;
}

.brand-link:hover { opacity: 0.9; }

.brand-mark {
  position: relative;
  width: 32px;
  height: 32px;
}

.brand-shape-main {
  position: absolute;
  top: 0;
  left: 0;
  width: 20px;
  height: 32px;
  background-color: var(--green-primary);
  border-radius: 10px 10px 10px 20px;
}

.brand-shape-accent {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 14px;
  height: 14px;
  background-color: var(--peach-accent);
  border-radius: 50%;
}

.brand-text-group {
  display: flex;
  flex-direction: column;
  line-height: 1;
}

.brand-name {
  font-family: var(--font-display);
  font-size: 22px;
  font-weight: 700;
  color: var(--green-primary);
  letter-spacing: -0.02em;
}

/* Nav links */
.navbar-links {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: nowrap;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  font-family: var(--font-primary);
  font-size: 14px;
  font-weight: 500;
  color: var(--text-secondary);
  text-decoration: none;
  border-radius: 12px;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.nav-link:hover {
  color: var(--green-primary);
  background: var(--bg-tertiary);
}

.nav-link-icon {
  font-size: 14px;
  opacity: 0.8;
}

/* Special messages link */
.nav-link-special {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  font-family: var(--font-primary);
  font-size: 14px;
  font-weight: 600;
  color: var(--green-action);
  text-decoration: none;
  border-radius: 12px;
  background: rgba(34, 197, 94, 0.1);
  transition: all 0.2s ease;
  white-space: nowrap;
}

.nav-link-special:hover {
  background: rgba(34, 197, 94, 0.15);
  color: #16A34A;
}

/* Profile pill */
.nav-link-profile-pill {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 4px 14px 4px 4px;
  font-family: var(--font-primary);
  font-size: 14px;
  font-weight: 500;
  color: var(--text-primary);
  text-decoration: none;
  border-radius: 9999px;
  border: 1px solid var(--border-color);
  background: var(--bg-secondary);
  transition: all 0.2s ease;
  white-space: nowrap;
}

.nav-link-profile-pill:hover {
  border-color: #D1D5DB;
  background: var(--bg-tertiary);
}

.profile-avatar {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--green-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 600;
  color: #fff;
  font-family: var(--font-primary);
  flex-shrink: 0;
}

/* Mobile toggle */
.mobile-menu-toggle {
  display: none;
  padding: 10px 12px;
  background: transparent;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  color: var(--text-primary);
  font-size: 18px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.mobile-menu-toggle:hover {
  background: var(--bg-tertiary);
}

/* Responsive */
@media (max-width: 992px) {
  .navbar-links {
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-color);
    padding: 24px;
    transform: translateY(-120%);
    opacity: 0;
    transition: all 0.3s ease;
    pointer-events: none;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }

  .navbar-links.active {
    transform: translateY(0);
    opacity: 1;
    pointer-events: all;
  }

  .nav-link, .nav-link-special, .nav-link-profile-pill {
    justify-content: flex-start;
    padding: 14px 16px;
    border-radius: 12px;
    font-size: 16px;
  }
  
  .btn {
    justify-content: center;
    margin-top: 8px;
  }

  .mobile-menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const toggle = document.getElementById('mobileMenuToggle');
  const menu = document.getElementById('navbarLinks');

  if (toggle && menu) {
    toggle.addEventListener('click', function () {
      menu.classList.toggle('active');
      const icon = toggle.querySelector('i');
      if (menu.classList.contains('active')) {
        icon.classList.replace('fa-bars', 'fa-xmark');
      } else {
        icon.classList.replace('fa-xmark', 'fa-bars');
      }
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!toggle.contains(e.target) && !menu.contains(e.target)) {
        menu.classList.remove('active');
        const icon = toggle.querySelector('i');
        if(icon) icon.classList.replace('fa-xmark', 'fa-bars');
      }
    });
  }

  // Highlight active nav link based on current path
  const path = window.location.pathname;
  document.querySelectorAll('.nav-link').forEach(link => {
    if (link.getAttribute('href') === path || (path.startsWith(link.getAttribute('href')) && link.getAttribute('href') !== '/home')) {
      link.style.color = 'var(--green-primary)';
      link.style.background = 'var(--bg-tertiary)';
      link.style.fontWeight = '600';
    }
  });
});
</script>
