<% layout("/layouts/boilerplate") %>

<!-- 
  🌟 GOD-LEVEL UI/UX REDESIGN: Job Details
  Premium Glassmorphism, Neon Accents, and Interactive Elements
-->

<style>
  :root {
    --primary-gradient: var(--gradient-primary);
    --success-gradient: linear-gradient(135deg, #10b981 0%, #059669 100%);
    --card-bg: rgba(25, 27, 31, 0.6);
    --glass-border: rgba(255, 255, 255, 0.05);
    --glass-highlight: rgba(255, 255, 255, 0.02);
    --neon-glow: var(--shadow-purple);
  }

  /* Global Layout Overrides for this page */
  .job-details-wrapper {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1rem;
    font-family: var(--font-primary);
  }

  /* ----------------------
     HERO SECTION
     ---------------------- */
  .job-hero-card {
    background: var(--card-bg);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    padding: 3.5rem;
    position: relative;
    overflow: hidden;
    margin-bottom: 2.5rem;
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  /* Ambient Glow Effect */
  .job-hero-card::before {
    content: '';
    position: absolute;
    top: -50px;
    right: -50px;
    width: 400px;
    height: 400px;
    background: var(--purple-primary);
    filter: blur(150px);
    opacity: 0.1;
    border-radius: 50%;
    z-index: 0;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .company-logo-large {
    width: 110px;
    height: 110px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--glass-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    font-weight: 800;
    color: #e2e8f0;
    box-shadow: inset 0 0 20px rgba(0,0,0,0.2);
  }

  .job-title-display {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.1;
    background: linear-gradient(to right, #ffffff, #cbd5e1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
  }

  .job-meta-row {
    display: flex;
    gap: 1.5rem;
    font-size: 1.1rem;
    color: #94a3b8;
  }

  .job-meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .job-meta-item i {
    color: var(--purple-primary);
  }

  /* Hero Actions */
  .hero-actions {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 1rem;
  }

  .btn-premium {
    background: var(--primary-gradient);
    color: var(--text-dark);
    padding: 1rem 2.5rem;
    border-radius: 16px;
    font-weight: 700;
    font-size: 1.1rem;
    border: none;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 25px -5px rgba(74, 210, 182, 0.35);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .btn-premium:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 20px 35px -5px rgba(74, 210, 182, 0.5);
    color: var(--text-dark);
  }

  .btn-glass {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(10px);
    border: 1px solid var(--glass-border);
    color: white;
    padding: 1rem 2rem;
    border-radius: 16px;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .btn-glass:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--purple-primary);
    color: var(--purple-light);
  }

  /* ----------------------
     GRID LAYOUT
     ---------------------- */
  .details-layout {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 2.5rem;
    position: relative;
  }

  @media (max-width: 1024px) {
    .details-layout {
      grid-template-columns: 1fr;
    }
  }

  /* ----------------------
     CONTENT CARD STYLES
     ---------------------- */
  .glass-panel {
    background: var(--card-bg);
    backdrop-filter: blur(16px);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    padding: 2.5rem;
    margin-bottom: 2rem;
  }

  .section-h3 {
    font-size: 1.75rem;
    font-weight: 700;
    color: #f1f5f9;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .section-h3::before {
    content: '';
    display: block;
    width: 6px;
    height: 30px;
    background: var(--primary-gradient);
    border-radius: 3px;
  }

  .rich-text {
    color: #cbd5e1;
    font-size: 1.1rem;
    line-height: 1.7;
    white-space: pre-wrap;
  }

  /* Skills Tags */
  .skill-tag-premium {
    background: rgba(74, 210, 182, 0.12);
    border: 1px solid rgba(74, 210, 182, 0.25);
    color: var(--purple-light);
    padding: 0.5rem 1.25rem;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 500;
    display: inline-block;
    margin-right: 0.5rem;
    margin-bottom: 0.5rem;
    transition: all 0.2s;
  }

  .skill-tag-premium:hover {
    background: rgba(74, 210, 182, 0.22);
    border-color: rgba(74, 210, 182, 0.45);
    transform: translateY(-1px);
  }

  /* ----------------------
     INTERVIEW TIMELINE
     ---------------------- */
  .timeline-pipeline {
    position: relative;
    padding-left: 20px;
    margin-top: 2rem;
  }

  .timeline-line {
    position: absolute;
    left: 45px;
    top: 30px;
    bottom: 30px;
    width: 2px;
    background: rgba(255, 255, 255, 0.1);
    z-index: 0;
  }

  .round-card-wrapper {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .round-status-icon {
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #0f172a;
    border: 2px solid #334155;
    color: #475569;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    position: relative;
    transition: all 0.3s ease;
  }

  .round-status-icon::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px solid transparent;
    transition: all 0.3s ease;
  }

  /* Status Variations */
  .status-state-locked .round-status-icon {
    background: #0f172a;
    border-color: #334155;
  }

  .status-state-unlocked .round-status-icon {
    background: #0f172a;
    border-color: #fbbf24;
    color: #fbbf24;
    box-shadow: 0 0 20px rgba(251, 191, 36, 0.2);
  }

  .status-state-cleared .round-status-icon {
    background: #10b981;
    border-color: #10b981;
    color: #022c22;
    box-shadow: 0 0 20px rgba(16, 185, 129, 0.3);
  }

  .round-detail-card {
    flex: 1;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--glass-border);
    border-radius: 18px;
    padding: 1.25rem 1.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: all 0.2s ease;
  }

  .round-detail-card:hover {
    background: rgba(255, 255, 255, 0.06);
    transform: translateX(5px);
  }

  /* ----------------------
     SIDEBAR
     ---------------------- */
  .sidebar-sticky {
    position: sticky;
    top: 2rem;
  }

  .fact-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .fact-row:last-child {
    border-bottom: none;
  }

  .fact-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--purple-primary);
    font-size: 1.2rem;
  }

  .fact-label {
    text-transform: uppercase;
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748b;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }

  .fact-value {
    font-size: 1rem;
    font-weight: 500;
    color: #f1f5f9;
  }

</style>

<div class="job-details-wrapper">
  
  <!-- Back Navigation -->
  <div class="mb-lg">
    <a href="/jobs" class="flex items-center text-muted hover:text-white transition-colors" style="width: fit-content; gap: 0.5rem">
      <i class="fa-solid fa-arrow-left"></i> <span>Back to Jobs Listing</span>
    </a>
  </div>

  <!-- Hero -->
  <header class="job-hero-card">
    <div class="hero-content">
      <div class="company-logo-large">
        <%= job.company ? job.company.charAt(0).toUpperCase() : 'C' %>
      </div>
      <div>
        <h1 class="job-title-display"><%= job.title %></h1>
        <div class="job-meta-row">
          <div class="job-meta-item">
            <i class="fa-regular fa-building"></i> <span><%= job.company %></span>
          </div>
          <div class="job-meta-item">
            <i class="fa-solid fa-location-dot"></i> <span><%= job.location %></span>
          </div>
          <div class="job-meta-item">
            <i class="fa-regular fa-clock"></i> <span>Posted <%= new Date().toLocaleDateString() %></span>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-actions">
      <% if (isOwner) { %>
        <a href="/jobs/edit/<%= job._id %>" class="btn-glass">
          <i class="fa-solid fa-pen-to-square"></i> Edit
        </a>
        <form action="/jobs/delete/<%= job._id %>" method="POST" onsubmit="return confirm('Delete this job?');" style="display: inline-block;">
          <button class="btn-glass hover:bg-red-500/20 hover:border-red-500/50 hover:text-red-400 transition-all" style="background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.3); color: #fca5a5;">
            <i class="fa-solid fa-trash"></i>
          </button>
        </form>
      <% } else { %>
        <button class="btn-premium">
          <span>Apply Now</span> <i class="fa-solid fa-arrow-right"></i>
        </button>
      <% } %>
    </div>
  </header>

  <!-- Main Grid -->
  <div class="details-layout">
    
    <!-- LEFT COLUMN -->
    <main>
      
      <!-- Descriptions -->
      <section class="glass-panel">
        <h3 class="section-h3">Job Description</h3>
        <div class="rich-text">
          <%= job.description %>
        </div>
      </section>

      <!-- Responsibilities -->
      <% if (job.responsibilities && (job.responsibilities.skills?.length || job.responsibilities.tasks?.length)) { %>
        <section class="glass-panel">
          <h3 class="section-h3">Key Responsibilities</h3>
          
          <div class="grid gap-lg">
            <% if (job.responsibilities.skills?.length) { %>
              <div>
                <h4 class="text-sm font-bold text-muted uppercase tracking-wider mb-sm">Technical Skills required</h4>
                <div class="flex flex-wrap">
                  <% job.responsibilities.skills.forEach(skill => { %>
                    <span class="skill-tag-premium"><%= skill %></span>
                  <% }) %>
                </div>
              </div>
            <% } %>

            <% if (job.responsibilities.tasks?.length) { %>
              <div>
                <h4 class="text-sm font-bold text-muted uppercase tracking-wider mb-sm">What you'll do</h4>
                <ul class="space-y-3">
                  <% job.responsibilities.tasks.forEach(task => { %>
                    <li class="flex items-start gap-3 text-gray-300">
                      <i class="fa-solid fa-check-circle text-purple-primary mt-1"></i>
                      <span><%= task %></span>
                    </li>
                  <% }) %>
                </ul>
              </div>
            <% } %>
          </div>
        </section>
      <% } %>

      <!-- Interview Pipeline -->
      <section class="glass-panel">
        <div class="flex justify-between items-end mb-md">
          <h3 class="section-h3 mb-0">Selection Process</h3>
          <span class="text-sm px-3 py-1 rounded-full bg-white/5 border border-white/10 text-muted">
            <%= job.roundsAdded %> Steps
          </span>
        </div>
        
        <div class="timeline-pipeline">
          <div class="timeline-line"></div>
          
          <% if (job.rounds && job.rounds.length > 0) { %>
            <% job.rounds.forEach((round, index) => { %>
              <% 
                 let statusState = 'status-state-locked';
                 let iconClass = 'fa-lock';
                 let labelText = 'Locked';

                 if (!round.isLocked) {
                   if (round.qualified) {
                     statusState = 'status-state-cleared';
                     iconClass = 'fa-check';
                     labelText = 'Completed';
                   } else {
                     statusState = 'status-state-unlocked';
                     iconClass = 'fa-unlock';
                     labelText = 'Open';
                   }
                 }
              %>
              
              <div class="round-card-wrapper <%= statusState %>">
                <div class="round-status-icon">
                  <i class="fa-solid <%= iconClass %>"></i>
                </div>
                
                <div class="round-detail-card">
                  <div>
                    <h4 class="text-lg font-bold text-white mb-1"><%= round.title %></h4>
                    <div class="flex items-center gap-4 text-sm text-gray-400">
                      <span><i class="fa-regular fa-hourglass mr-1"></i> <%= round.duration %> min</span>
                      <span class="w-1 h-1 bg-gray-600 rounded-full"></span>
                      <span><%= round.roundType || 'Assessment' %></span>
                    </div>
                  </div>

                  <div class="flex items-center gap-3">
                    <% if (!round.isLocked && !round.qualified) { %>
                      <a href="/rounds/start-round/<%= round._id %>" class="btn-premium px-6 py-2 text-sm">
                        Start
                      </a>
                    <% } else if (round.qualified) { %>
                      <span class="text-green-400 font-bold text-sm tracking-wide">
                        CLEARED <i class="fa-solid fa-circle-check ml-1"></i>
                      </span>
                    <% } else { %>
                      <span class="text-gray-500 text-sm font-medium flex items-center gap-1">
                        <i class="fa-solid fa-lock text-xs"></i> LOCKED
                      </span>
                    <% } %>

                    <% if (isOwner) { %>
                       <div class="flex items-center gap-2 pl-4 border-l border-white/10 ml-2">
                         <a href="/rounds/<%= round._id %>/results" class="p-2 rounded-lg bg-white/5 text-gray-300 hover:text-green-400 hover:bg-white/10 transition-all" title="View Candidate Results">
                           <i class="fa-solid fa-users-viewfinder"></i>
                         </a>
                         <a href="/rounds/<%= round.roundType.toLowerCase() %>/edit/<%= round._id %>" class="p-2 rounded-lg bg-white/5 text-gray-300 hover:text-white hover:bg-white/10 transition-all" title="Edit Round Settings">
                           <i class="fa-solid fa-gear"></i>
                         </a>
                       </div>
                    <% } %>
                  </div>
                </div>
              </div>

            <% }) %>
          <% } else { %>
            <div class="p-4 text-center text-muted border border-dashed border-white/10 rounded-xl">
              No interview rounds configured yet.
            </div>
          <% } %>

          <% if (isOwner) { %>
            <div class="mt-8 ml-12 pl-6">
              <a href="/rounds/select-round/<%= job._id %>" class="block p-4 text-center border border-dashed border-purple-primary/30 rounded-xl text-purple-light hover:bg-purple-primary/10 transition-colors">
                <i class="fa-solid fa-plus-circle mr-2"></i> Add Interview Round
              </a>
            </div>
          <% } %>

        </div>
      </section>

    </main>

    <!-- RIGHT SIDEBAR -->
    <aside>
      <div class="glass-panel sidebar-sticky">
        <h4 class="text-xl font-bold text-white mb-6 border-b border-white/10 pb-4">Overview</h4>
        
        <div class="fact-row">
          <div class="fact-icon-box"><i class="fa-solid fa-sack-dollar"></i></div>
          <div>
            <div class="fact-label">Salary</div>
            <div class="fact-value"><%= job.salaryRange || 'Not disclosed' %></div>
          </div>
        </div>

        <div class="fact-row">
          <div class="fact-icon-box"><i class="fa-solid fa-briefcase"></i></div>
          <div>
            <div class="fact-label">Job Type</div>
            <div class="fact-value"><%= job.jobType %></div>
          </div>
        </div>

        <div class="fact-row">
          <div class="fact-icon-box"><i class="fa-solid fa-laptop-house"></i></div>
          <div>
            <div class="fact-label">Location Type</div>
            <div class="fact-value"><%= job.mode %></div>
          </div>
        </div>

        <div class="fact-row">
          <div class="fact-icon-box"><i class="fa-solid fa-layer-group"></i></div>
          <div>
            <div class="fact-label">Experience</div>
            <div class="fact-value"><%= job.experienceRequired || 'Freshers' %></div>
          </div>
        </div>

        <div class="fact-row">
          <div class="fact-icon-box"><i class="fa-regular fa-calendar-xmark"></i></div>
          <div>
            <div class="fact-label">Deadline</div>
            <div class="fact-value text-orange-300">
              <%= job.deadlineDate ? new Date(job.deadlineDate).toLocaleDateString() : 'Open' %>
            </div>
          </div>
        </div>

        <% if (job.skillsRequired && job.skillsRequired.length > 0) { %>
          <div class="mt-8 pt-6 border-t border-white/10">
            <h5 class="text-sm font-bold text-muted uppercase mb-4">Core Competencies</h5>
            <div class="flex flex-wrap gap-2">
              <% job.skillsRequired.forEach(skill => { %>
                <span class="text-xs font-semibold px-2 py-1 bg-white/5 rounded border border-white/10 text-gray-300">
                  <%= skill %>
                </span>
              <% }) %>
            </div>
          </div>
        <% } %>

      </div>
    </aside>

  </div>
</div>
