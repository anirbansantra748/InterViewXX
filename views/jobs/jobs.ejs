<% layout("/layouts/boilerplate") %>

<style>
  /* Job Listing Specific Styles */
  .jobs-header {
    text-align: center;
    padding: var(--spacing-2xl) 0;
    position: relative;
    overflow: hidden;
  }

  .jobs-title {
    font-size: var(--text-5xl);
    font-weight: var(--font-extrabold);
    background: var(--gradient-secondary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: var(--spacing-md);
  }

  /* Job Card Enhanced */
  .job-card {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    transition: all var(--transition-base);
    backdrop-filter: blur(10px);
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    overflow: hidden;
  }
  
  .job-card:hover {
    transform: translateY(-5px);
    border-color: var(--purple-primary);
    box-shadow: var(--shadow-purple);
  }

  .job-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--gradient-primary);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .job-card:hover::before {
    opacity: 1;
  }

  .company-logo-placeholder {
    width: 48px;
    height: 48px;
    background: var(--glass-bg-hover);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-xl);
    font-weight: bold;
    color: var(--purple-light);
    margin-bottom: var(--spacing-md);
  }

  .job-title {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin-bottom: var(--spacing-xs);
    line-height: 1.3;
  }
  
  .job-company {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    margin-bottom: var(--spacing-md);
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .job-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-lg);
    flex-grow: 1;
  }
  
  .job-footer {
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--glass-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
  }

  .salary-text {
    font-size: var(--text-sm);
    color: var(--success);
    font-weight: var(--font-medium);
  }

  /* Filter Section */
  .jobs-filter-bar {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    margin-bottom: var(--spacing-2xl);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-md);
    align-items: end;
  }
</style>

<div class="container">
  
  <!-- Header -->
  <header class="jobs-header">
    <h1 class="jobs-title">Find Your Dream Role</h1>
    <p class="text-muted text-lg max-w-2xl mx-auto">
      Browse open positions from top tech companies and startups.
    </p>
    
    <div class="flex flex-center gap-md mt-lg">
      <a href="/jobs/create" class="btn btn-primary">
        <i class="fa-solid fa-plus-circle"></i> Post a Job
      </a>
      <a href="/jobs/myjobs" class="btn btn-secondary">
        <i class="fa-solid fa-briefcase"></i> My Applications
      </a>
    </div>
  </header>

  <!-- Search & Filter -->
  <div class="jobs-filter-bar">
    <div class="form-group mb-0">
      <label class="form-label">Search</label>
      <input type="text" class="form-input" placeholder="Job title or keyword...">
    </div>
    <div class="form-group mb-0">
      <label class="form-label">Location</label>
      <select class="form-select">
        <option value="">Any Location</option>
        <option>Remote</option>
        <option>On-site</option>
        <option>Hybrid</option>
      </select>
    </div>
    <div class="form-group mb-0">
      <label class="form-label">Type</label>
      <select class="form-select">
        <option value="">Any Type</option>
        <option>Full-time</option>
        <option>Contract</option>
        <option>Internship</option>
      </select>
    </div>
    <div>
      <button class="btn btn-primary w-full">
        <i class="fa-solid fa-search"></i> Find Jobs
      </button>
    </div>
  </div>

  <!-- Jobs Grid -->
  <% if (allJobs && allJobs.length > 0) { %>
    <div class="grid grid-auto">
      <% allJobs.forEach(job => { %>
        <article class="job-card">
          <div class="flex justify-between items-start">
            <div class="company-logo-placeholder">
              <%= job.company ? job.company.charAt(0).toUpperCase() : 'C' %>
            </div>
            <% if (job.jobType) { %>
              <span class="badge badge-secondary"><%= job.jobType %></span>
            <% } %>
          </div>

          <h3 class="job-title"><%= job.title %></h3>
          <div class="job-company">
            <i class="fa-regular fa-building"></i> 
            <%= job.company %> 
            <span class="mx-1">•</span>
            <i class="fa-solid fa-location-dot"></i>
            <%= job.location || 'Remote' %>
          </div>

          <div class="job-tags">
            <% if (job.skillsRequired && job.skillsRequired.length > 0) { %>
              <% job.skillsRequired.slice(0, 3).forEach(skill => { %>
                <span class="badge badge-secondary text-xs"><%= skill %></span>
              <% }) %>
              <% if (job.skillsRequired.length > 3) { %>
                <span class="badge badge-secondary text-xs">+<%= job.skillsRequired.length - 3 %></span>
              <% } %>
            <% } %>
          </div>

          <div class="job-footer">
            <span class="salary-text">
              <%= job.salaryRange || 'Competitive' %>
            </span>
            <a href="/jobs/<%= job._id %>" class="btn btn-sm btn-outline">
              View Details <i class="fa-solid fa-arrow-right ml-1"></i>
            </a>
          </div>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-icon">💼</div>
      <h3 class="empty-title">No jobs found yet</h3>
      <p class="empty-subtitle">Check back later or post the first opportunity!</p>
    </div>
  <% } %>

</div>
