<% layout("/layouts/boilerplate") %>

<!-- 
  PROFESSIONAL QUESTION VIEW REDESIGN 
  Uses design-system.css variables and components
-->

<style>
  /* Page Specific Styles */
  .question-view-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--spacing-xl) var(--spacing-md);
  }
  
  /* Breadcrumb */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-xl);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  
  .breadcrumb i {
    font-size: 10px;
    opacity: 0.7;
  }
  
  .breadcrumb a {
    color: var(--text-secondary);
  }
  
  .breadcrumb a:hover {
    color: var(--purple-light);
    text-decoration: underline;
  }

  /* Question Header */
  .q-header {
    margin-bottom: var(--spacing-xl);
  }
  
  .q-title {
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: var(--spacing-md);
    line-height: 1.3;
  }
  
  .q-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    align-items: center;
    margin-bottom: var(--spacing-md);
  }
  
  .q-meta-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  /* Main Content Card */
  .q-card {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-2xl);
    backdrop-filter: blur(16px);
    box-shadow: var(--shadow-lg);
    margin-bottom: var(--spacing-2xl);
  }
  
  .q-text {
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--text-primary);
    margin-bottom: var(--spacing-xl);
    white-space: pre-wrap; /* Preserves formatting */
  }

  /* Form Elements */
  .answer-section {
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-xl);
    border-top: 1px solid var(--glass-border);
  }
  
  .option-label {
    display: flex;
    align-items: center;
    padding: var(--spacing-md) var(--spacing-lg);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: var(--transition-base);
    margin-bottom: var(--spacing-sm);
  }
  
  .option-label:hover {
    background: var(--glass-bg-hover);
    transform: translateX(4px);
    border-color: var(--purple-light);
  }
  
  .option-radio {
    margin-right: var(--spacing-md);
    accent-color: var(--purple-primary);
    width: 20px;
    height: 20px;
  }
  
  .saq-textarea {
    width: 100%;
    min-height: 150px;
    padding: var(--spacing-md);
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-family: var(--font-primary);
    font-size: var(--text-base);
    resize: vertical;
    outline: none;
    transition: var(--transition-base);
  }
  
  .saq-textarea:focus {
    border-color: var(--purple-primary);
    box-shadow: 0 0 0 2px rgba(122, 95, 251, 0.2);
  }

  /* Explanation Section */
  .explanation-box {
    margin-top: var(--spacing-2xl);
    background: rgba(245, 158, 11, 0.05);
    border: 1px solid rgba(245, 158, 11, 0.2);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
  }
  
  .explanation-title {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    color: var(--warning);
    font-weight: var(--font-bold);
    margin-bottom: var(--spacing-sm);
  }

  /* Author & Actions */
  .q-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--glass-border);
    flex-wrap: wrap;
    gap: var(--spacing-md);
  }
  
  .admin-actions {
    display: flex;
    gap: var(--spacing-sm);
  }
</style>

<div class="question-view-container">
  
  <!-- Breadcrumb Navigation -->
  <nav class="breadcrumb">
    <a href="/home">Home</a>
    <i class="fa-solid fa-chevron-right"></i>
    <a href="/questions/list">Questions</a>
    <i class="fa-solid fa-chevron-right"></i>
    <span><%= question.title.length > 30 ? question.title.substring(0, 30) + '...' : question.title %></span>
  </nav>

  <!-- Question Header -->
  <header class="q-header">
    <h1 class="q-title"><%= question.questionText || question.title %></h1>
    
    <div class="q-meta-row">
      <!-- Difficulty Badge -->
      <% if (question.difficulty === 'easy') { %>
        <span class="badge badge-easy">Easy</span>
      <% } else if (question.difficulty === 'medium') { %>
        <span class="badge badge-medium">Medium</span>
      <% } else if (question.difficulty === 'hard') { %>
        <span class="badge badge-hard">Hard</span>
      <% } %>

      <!-- Type Badge -->
      <span class="badge badge-secondary">
        <%= question.type.toUpperCase() %>
      </span>

      <!-- Points -->
      <div class="q-meta-item">
        <i class="fa-solid fa-star text-warning"></i>
        <span><%= question.points %> Pts</span>
      </div>

      <!-- Date -->
      <div class="q-meta-item">
        <i class="fa-regular fa-calendar"></i>
        <span><%= new Date(question.createdAt).toLocaleDateString() %></span>
      </div>

      <!-- Tags -->
      <% if (question.tags && question.tags.length > 0) { %>
        <div class="flex gap-xs">
          <% question.tags.forEach(tag => { %>
            <span class="badge badge-secondary text-xs">#<%= tag %></span>
          <% }) %>
        </div>
      <% } %>
    </div>
  </header>

  <!-- Main Content Card -->
  <main class="q-card">
    
    <!-- Question Description/Text -->
    <div class="q-text">
      <!-- 
           Ideally this would be markdown rendered, 
           but we'll use simple text for now 
      -->
      <%= question.questionText %>
    </div>

    <!-- Answer Form -->
    <div class="answer-section">
      <form action="/questions/<%= question._id %>/submit" method="POST">
        
        <% if (question.type === "mcq") { %>
          <h3 class="text-xl fw-bold mb-md">Choose Correct Option</h3>
          
          <div class="flex flex-col gap-sm">
            <% question.options.forEach((opt, i) => { %>
              <label class="option-label">
                <input type="radio" name="userAnswer" value="<%= opt %>" class="option-radio" required>
                <span>
                  <strong class="text-purple mr-2"><%= String.fromCharCode(65 + i) %>.</strong> 
                  <%= opt %>
                </span>
              </label>
            <% }) %>
          </div>

        <% } else if (question.type === "saq") { %>
          <h3 class="text-xl fw-bold mb-md">Your Answer</h3>
          <p class="text-muted text-sm mb-md">Write a concise and accurate answer.</p>
          
          <textarea 
            name="userAnswer" 
            class="saq-textarea" 
            placeholder="Type your answer here..." 
            required></textarea>
        <% } %>

        <div class="mt-lg">
          <button type="submit" class="btn btn-primary btn-lg">
            <i class="fa-solid fa-paper-plane"></i>
            Submit Answer
          </button>
        </div>
      </form>
    </div>

    <!-- Explanation (If available/shown) -->
    <!-- Logic to show explanation only after submission would go here, 
         but based on current requirement we'll just style it -->
    <% if (question.explanation) { %>
      <div class="explanation-box">
        <div class="explanation-title">
          <i class="fa-solid fa-lightbulb"></i>
          <span>Explanation</span>
        </div>
        <p><%= question.explanation %></p>
      </div>
    <% } %>

    <!-- Footer Meta -->
    <div class="q-footer">
      <div class="q-meta-item">
        <i class="fa-solid fa-user-circle"></i>
        <span>Created by <strong><%= question.createdBy ? question.createdBy.fullName : 'Admin' %></strong></span>
      </div>

      <div class="flex gap-md items-center">
        <!-- Like Button -->
        <form action="/questions/<%= question._id %>/like" method="POST" class="inline">
          <button type="submit" class="btn btn-sm btn-secondary text-pink-accent">
            <i class="fa-solid fa-heart"></i>
            <%= question.likes || 0 %> Likes
          </button>
        </form>

        <!-- Admin Actions -->
        <% if (isAdmin) { %>
          <div class="admin-actions">
            <a href="/questions/<%= question._id %>/edit" class="btn btn-sm btn-outline">
              <i class="fa-solid fa-edit"></i> Edit
            </a>
            <form action="/questions/<%= question._id %>?_method=DELETE" method="POST" class="inline" onsubmit="return confirm('Delete this question?');">
              <button type="submit" class="btn btn-sm btn-error">
                <i class="fa-solid fa-trash"></i>
              </button>
            </form>
          </div>
        <% } %>
      </div>
    </div>

  </main>

</div>
