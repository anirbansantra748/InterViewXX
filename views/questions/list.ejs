<% layout("/layouts/boilerplate") %>

<style>
  .questions-header {
    text-align: center;
    padding: var(--spacing-2xl) 0;
    margin-bottom: var(--spacing-2xl);
  }

  .questions-title {
    font-size: var(--text-4xl);
    font-weight: var(--font-extrabold);
    margin-bottom: var(--spacing-md);
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .filter-section-questions {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: var(--spacing-xl);
    backdrop-filter: blur(10px);
    margin-bottom: var(--spacing-2xl);
  }

  .filter-form {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr auto;
    gap: var(--spacing-md);
  }

  @media (max-width: 992px) {
    .filter-form {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .filter-form {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="container">
  <!-- Header -->
  <div class="questions-header">
    <h1 class="questions-title">📘 All Questions</h1>
    <p class="text-muted">Browse and solve interview questions</p>
  </div>

  <!-- Filters -->
  <div class="filter-section-questions">
    <form method="GET" action="/questions/list" class="filter-form">
      <div class="form-group">
        <input 
          type="text" 
          name="search" 
          class="form-input" 
          placeholder="🔍 Search questions..."
          value="<%= query?.search || '' %>"
        />
      </div>

      <div class="form-group">
        <select name="type" class="form-select">
          <option value="">🧮 All Types</option>
          <option value="mcq" <%= query?.type === 'mcq' ? 'selected' : '' %>>MCQ</option>
          <option value="saq" <%= query?.type === 'saq' ? 'selected' : '' %>>SAQ</option>
        </select>
      </div>

      <div class="form-group">
        <select name="difficulty" class="form-select">
          <option value="">All Difficulty</option>
          <option value="easy" <%= query?.difficulty === 'easy' ? 'selected' : '' %>>Easy</option>
          <option value="medium" <%= query?.difficulty === 'medium' ? 'selected' : '' %>>Medium</option>
          <option value="hard" <%= query?.difficulty === 'hard' ? 'selected' : '' %>>Hard</option>
        </select>
      </div>

      <div class="form-group">
        <button type="submit" class="btn btn-primary w-full">
          <i class="fa-solid fa-filter"></i>
          Filter
        </button>
      </div>
    </form>
  </div>

  <!-- Questions Grid -->
  <% if (questions.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">🔍</div>
      <h3 class="empty-title">No questions found</h3>
      <p class="empty-subtitle">Try adjusting your search filters</p>
      <a href="/questions/list" class="btn btn-primary mt-lg">
        <i classfa-solid fa-refresh"></i>
        Show All Questions
      </a>
    </div>
  <% } else { %>
    <div class="grid grid-auto">
      <% questions.forEach(q => { %>
        <article class="question-card-enhanced">
          <div class="question-header">
            <div>
              <h3 class="question-title"><%= q.questionText.length > 100 ? q.questionText.slice(0, 100) + '...' : q.questionText %></h3>
              <div class="question-meta">
                <% if (q.difficulty === 'easy') { %>
                  <span class="badge badge-easy">Easy</span>
                <% } else if (q.difficulty === 'medium') { %>
                  <span class="badge badge-medium">Medium</span>
                <% } else if (q.difficulty === 'hard') { %>
                  <span class="badge badge-hard">Hard</span>
                <% } %>
                
                <span class="badge badge-secondary">
                  <i class="fa-solid fa-<%= q.type === 'mcq' ? 'check-circle' : 'pen' %>"></i>
                  <%= q.type.toUpperCase() %>
                </span>
              </div>
            </div>
          </div>

          <% if (q.tags && q.tags.length > 0) { %>
            <div class="question-tags">
              <% q.tags.slice(0, 3).forEach(tag => { %>
                <span class="badge badge-primary">#<%= tag %></span>
              <% }) %>
            </div>
          <% } %>

          <div class="question-stats">
            <div class="stat-item">
              <i class="fa-solid fa-star" style="color: var(--warning);"></i>
              <span><%= q.points || 5 %> pts</span>
            </div>
            <% if (q.createdAt) { %>
              <div class="stat-item">
                <i class="fa-solid fa-clock"></i>
                <span><%= new Date(q.createdAt).toLocaleDateString() %></span>
              </div>
            <% } %>
          </div>

          <div class="question-footer">
            <div></div>
            <a href="/questions/<%= q._id %>" class="btn btn-sm btn-primary">
              <i class="fa-solid fa-play"></i>
              Solve Now
            </a>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</div>
