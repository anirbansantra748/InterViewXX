<% layout("/layouts/boilerplate") %>

<style>
  .employer-form-container {
    max-width: 800px;
    margin: var(--spacing-3xl) auto;
    padding: var(--spacing-xl);
  }

  .form-header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }

  .form-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--green-primary);
    font-weight: 700;
    margin-bottom: var(--spacing-xs);
  }

  .form-subtitle {
    color: var(--text-secondary);
    font-size: var(--text-lg);
  }

  .employer-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: var(--spacing-2xl);
    box-shadow: var(--shadow-sm);
  }

  .form-section {
    margin-bottom: var(--spacing-xl);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--green-primary);
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-sm);
    border-bottom: 2px solid var(--border-color);
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md) var(--spacing-lg);
  }

  .form-group-full {
    grid-column: 1 / -1;
  }

  @media (max-width: 600px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="employer-form-container">
  <div class="form-header">
    <h2 class="form-title">Employer Profile</h2>
    <p class="form-subtitle">Complete your company profile to start discovering top talent.</p>
  </div>

  <div class="employer-card">
    <form action="/recruiter/profile" method="POST">
      
      <div class="form-section">
        <h3 class="section-title">Company Details</h3>
        <div class="form-grid">
          
          <div class="form-group form-group-full">
            <label class="form-label">Company Name</label>
            <input type="text" class="form-input" name="companyDetails[name]" required placeholder="e.g., TechVerse Inc.">
          </div>

          <div class="form-group form-group-full">
            <label class="form-label">Description</label>
            <textarea class="form-input" name="companyDetails[description]" placeholder="Brief about your company mission and vision..." rows="4"></textarea>
          </div>

          <div class="form-group">
            <label class="form-label">Website</label>
            <input type="text" class="form-input" name="companyDetails[website]" placeholder="https://techverse.com">
          </div>

          <div class="form-group">
            <label class="form-label">Location</label>
            <input type="text" class="form-input" name="companyDetails[location]" placeholder="City, Country">
          </div>

          <div class="form-group">
            <label class="form-label">Industry</label>
            <input type="text" class="form-input" name="companyDetails[industry]" placeholder="e.g., IT Services, Fintech">
          </div>

          <div class="form-group">
            <label class="form-label">Company Size</label>
            <select class="form-select" name="companyDetails[size]">
              <option value="">Select size...</option>
              <option value="1-10">1-10 employees</option>
              <option value="11-50">11-50 employees</option>
              <option value="51-200">51-200 employees</option>
              <option value="201-500">201-500 employees</option>
              <option value="500+">500+ employees</option>
            </select>
          </div>

        </div>
      </div>

      <div class="form-section">
        <h3 class="section-title">Your Role</h3>
        <div class="form-group">
          <label class="form-label">Your Designation</label>
          <input type="text" class="form-input" name="designation" required placeholder="e.g., HR Manager, Technical Recruiter, CTO">
        </div>
      </div>

      <div class="text-right">
        <button type="submit" class="btn btn-primary btn-lg">
          <i class="fa-solid fa-floppy-disk mr-1"></i> Save Profile
        </button>
      </div>

    </form>
  </div>
</div>
