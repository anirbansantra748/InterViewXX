<% layout("/layouts/boilerplate") %>

<style>
  /* =============================================
     HERO — HIRESKA EDITION
     ============================================= */
  .hero-section {
    padding: 100px 0 80px;
    position: relative;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  /* Organic Abstract Shape behind Hero */
  .hero-bg-shape {
    position: absolute;
    top: -10%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: var(--bg-tertiary);
    border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
    z-index: 1;
    opacity: 0.8;
  }

  .hero-bg-shape-2 {
    position: absolute;
    bottom: 10%;
    left: -10%;
    width: 400px;
    height: 400px;
    background: rgba(255, 159, 110, 0.08); /* Peach accent */
    border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
    z-index: 1;
  }

  /* Eyebrow label */
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 24px;
    box-shadow: var(--shadow-sm);
  }

  .hero-eyebrow-dot {
    width: 8px;
    height: 8px;
    background: var(--green-action);
    border-radius: 50%;
  }

  .hero-title {
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--spacing-lg);
    color: var(--green-primary);
    letter-spacing: -0.03em;
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin-bottom: var(--spacing-2xl);
    max-width: 600px;
    line-height: 1.6;
  }

  .hero-cta {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    margin-bottom: 60px;
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-lg);
    width: 100%;
    margin-top: var(--spacing-xl);
  }

  .stat-card-hero {
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    padding: 24px;
    text-align: left;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-color);
  }

  .stat-value-hero {
    font-size: 2.5rem;
    font-weight: 700;
    font-family: var(--font-display);
    color: var(--green-primary);
    line-height: 1;
    margin-bottom: 8px;
  }

  .stat-label-hero {
    font-size: 14px;
    color: var(--text-secondary);
    font-weight: 500;
  }

  /* Filter Section */
  .filter-section {
    margin: var(--spacing-2xl) 0;
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    justify-content: center;
    margin-bottom: var(--spacing-xl);
  }

  /* Question Card */
  .question-card-enhanced {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    transition: all 0.3s ease;
    box-shadow: var(--shadow-sm);
  }

  .question-card-enhanced:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: rgba(14, 59, 46, 0.15);
  }

  .question-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--spacing-sm);
  }

  .question-title {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--green-primary);
    margin-bottom: var(--spacing-sm);
    line-height: 1.4;
  }

  .question-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }

  .question-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-md);
  }

  .question-stats {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--spacing-md);
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .question-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--border-color);
  }

  /* Hot Questions */
  .hot-questions-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .hot-question-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: var(--spacing-md) var(--spacing-lg);
    transition: var(--transition-base);
  }

  .hot-question-item:hover {
    transform: translateX(4px);
    border-color: rgba(245, 158, 11, 0.4);
    box-shadow: var(--shadow-sm);
  }

  .hot-question-content h4 {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--green-primary);
    margin-bottom: var(--spacing-xs);
  }

  .hot-badge {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-weight: 600;
    color: #F59E0B;
    font-size: var(--text-lg);
  }

  /* Search Container overriding for home */
  .hero-search-wrapper {
    width: 100%;
    max-width: 600px;
    margin: 0 auto var(--spacing-xl);
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    padding: var(--spacing-3xl);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .hero-title { font-size: 2.5rem; }
    .hero-cta { flex-direction: column; align-items: stretch; }
  }
</style>

<!-- Hero Section Background Shapes -->
<div class="hero-bg-shape"></div>
<div class="hero-bg-shape-2"></div>

<div class="container relative z-10">
  <section class="hero-section">
    <div class="hero-content">

      <!-- Eyebrow -->
      <div class="hero-eyebrow">
        <span class="hero-eyebrow-dot"></span>
        Real People. Real Skills. Real Opportunities.
      </div>

      <h1 class="hero-title">
        Hiring <br>
        human potential, <br>
        not just résumés.
      </h1>
      <p class="hero-subtitle">
        Live interviews, collaborative coding, and AI-powered insights — all in one place.
      </p>

      <!-- Search Bar -->
      <div class="hero-search-wrapper">
        <form method="GET" action="/home">
          <div class="search-container">
            <i class="fa-solid fa-search search-icon"></i>
            <input 
              type="text" 
              name="search" 
              class="search-input" 
              placeholder="Search jobs, companies, or skills..." 
              value="<%= searchQuery %>"
            />
          </div>
        </form>
      </div>

      <!-- CTA Buttons -->
      <div class="hero-cta">
        <a href="/users/register" class="btn btn-primary btn-lg">
          Get Started <i class="fa-solid fa-arrow-right ml-1"></i>
        </a>
        <a href="/questions/list" class="btn btn-secondary btn-lg">
          <i class="fa-solid fa-play-circle mr-1"></i> Watch Video
        </a>
      </div>

      <!-- Stats -->
      <div class="stats-grid">
        <div class="stat-card-hero">
          <div class="stat-value-hero">10K+</div>
          <div class="stat-label-hero">Candidates</div>
        </div>
        <div class="stat-card-hero">
          <div class="stat-value-hero">2K+</div>
          <div class="stat-label-hero">Companies</div>
        </div>
        <div class="stat-card-hero">
          <div class="stat-value-hero">50K+</div>
          <div class="stat-label-hero">Interviews</div>
        </div>
        <div class="stat-card-hero">
          <div class="stat-value-hero">95%</div>
          <div class="stat-label-hero">Satisfaction Rate</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Filter Section -->
  <section class="filter-section" id="explore">
    <h3 class="text-center mb-4" style="color: var(--green-primary);">Explore Opportunities</h3>
    <div class="filter-pills">
      <span class="tag <%= searchQuery === '' ? 'active' : '' %>" onclick="location.href='/home'">
        All
      </span>
      <span class="tag <%= searchQuery === 'DSA' ? 'active' : '' %>" onclick="location.href='/home?search=DSA'">
        Engineering
      </span>
      <span class="tag <%= searchQuery === 'Design' ? 'active' : '' %>" onclick="location.href='/home?search=Design'">
        Design
      </span>
      <span class="tag <%= searchQuery === 'Product' ? 'active' : '' %>" onclick="location.href='/home?search=Product'">
        Product
      </span>
      <span class="tag <%= searchQuery === 'Marketing' ? 'active' : '' %>" onclick="location.href='/home?search=Marketing'">
        Marketing
      </span>
    </div>
  </section>

  <!-- Content Grid -->
  <section class="mb-5">
    <div class="section-title">
      <%= searchQuery ? 'Search Results' : 'Recommended for you' %>
    </div>
    
    <% if (allQuestions.length > 0) { %>
      <div class="grid grid-auto">
        <% allQuestions.forEach(q => { %>
          <article class="question-card-enhanced">
            <div class="question-header">
              <div class="flex-1">
                <h4 class="question-title"><%= q.title %></h4>
                <div class="question-meta">
                  <% if (q.difficulty === 'easy') { %>
                    <span class="badge badge-easy">Junior</span>
                  <% } else if (q.difficulty === 'medium') { %>
                    <span class="badge badge-medium">Mid-Level</span>
                  <% } else if (q.difficulty === 'hard') { %>
                    <span class="badge badge-hard">Senior</span>
                  <% } %>
                  
                  <span class="badge badge-secondary">
                    <%= q.type.toUpperCase() %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Tags -->
            <% if (q.tags && q.tags.length > 0) { %>
              <div class="question-tags">
                <% q.tags.slice(0, 3).forEach(tag => { %>
                  <span class="tag" style="padding: 4px 10px; font-size: 12px;"><%= tag %></span>
                <% }) %>
              </div>
            <% } %>

            <!-- Footer -->
            <div class="question-footer">
              <div class="text-sm text-muted">
                Posted <%= q.createdAt ? new Date(q.createdAt).toLocaleDateString() : 'Recently' %>
              </div>
              <a href="/questions/<%= q._id %>" class="text-primary font-medium" style="font-size: 14px;">
                View Details <i class="fa-solid fa-arrow-right ml-1"></i>
              </a>
            </div>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <h3 style="font-family: var(--font-display); color: var(--green-primary); margin-bottom: 8px;">No results found</h3>
        <p class="text-secondary mb-3">Try adjusting your search or filter criteria</p>
        <a href="/home" class="btn btn-secondary">
          Clear Filters
        </a>
      </div>
    <% } %>
  </section>

  <!-- Hot Questions Section -->
  <% if (hotQuestions && hotQuestions.length > 0) { %>
    <section class="mb-5">
      <div class="section-title">Trending Now</div>
      <div class="hot-questions-list">
        <% hotQuestions.forEach(q => { %>
          <div class="hot-question-item">
            <div class="hot-question-content">
              <h4>
                <a href="/questions/<%= q._id %>" style="color: inherit; text-decoration: none;">
                  <%= q.title %>
                </a>
              </h4>
              <p class="text-sm text-secondary m-0">
                <% if (q.tags && q.tags.length > 0) { %>
                  <%= q.tags.slice(0, 2).join(', ') %>
                <% } %>
              </p>
            </div>
            <a href="/questions/<%= q._id %>" class="btn btn-sm btn-outline">View</a>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>
</div>
