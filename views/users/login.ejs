<% layout("/layouts/boilerplate") %>

<style>
  .auth-split-layout {
    display: flex;
    min-height: calc(100vh - 72px);
    width: 100%;
  }

  .auth-form-side {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-2xl);
    background: var(--bg-primary);
  }

  .auth-visual-side {
    flex: 1;
    display: none;
    background: var(--bg-tertiary);
    position: relative;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-3xl);
  }

  @media (min-width: 992px) {
    .auth-visual-side {
      display: flex;
    }
  }

  .auth-card-inner {
    width: 100%;
    max-width: 420px;
    animation: fadeInUp 0.5s ease-out;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .auth-header {
    margin-bottom: var(--spacing-xl);
  }

  .auth-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--spacing-lg);
  }

  .brand-dot {
    width: 12px;
    height: 12px;
    background-color: var(--green-action);
    border-radius: 50%;
  }

  .auth-title {
    font-size: var(--text-4xl);
    color: var(--green-primary);
    margin-bottom: var(--spacing-sm);
  }

  .auth-subtitle {
    color: var(--text-secondary);
    font-size: var(--text-base);
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .password-toggle {
    position: absolute;
    right: 16px;
    top: 42px; /* Adjusted for label */
    color: var(--text-muted);
    cursor: pointer;
    font-size: var(--text-lg);
    transition: var(--transition-base);
  }

  .password-toggle:hover {
    color: var(--green-primary);
  }

  .auth-footer {
    margin-top: var(--spacing-xl);
    text-align: center;
  }

  /* Visual side graphic */
  .visual-graphic {
    position: relative;
    width: 100%;
    max-width: 500px;
    aspect-ratio: 1;
    background: var(--bg-secondary);
    border-radius: 30px 100px 30px 100px; /* Organic shape */
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--spacing-2xl);
  }
  
  .visual-graphic::before {
    content: '';
    position: absolute;
    top: -20px;
    right: -20px;
    width: 100px;
    height: 100px;
    background: var(--peach-accent);
    border-radius: 50%;
    z-index: -1;
  }

  .visual-text {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--green-primary);
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: var(--spacing-md);
  }
  
  .visual-subtext {
    color: var(--text-secondary);
    font-size: var(--text-lg);
  }
</style>

<div class="auth-split-layout">
  <!-- Form Side -->
  <div class="auth-form-side">
    <div class="auth-card-inner">
      <div class="auth-header">
        <div class="auth-brand">
          <div class="brand-dot"></div>
          <span style="font-family: var(--font-display); font-weight: 700; color: var(--green-primary);">Hireska</span>
        </div>
        <h1 class="auth-title">Welcome back.</h1>
        <p class="auth-subtitle">Log in to continue your recruitment journey.</p>
      </div>

      <form class="auth-form" action="/users/login" method="POST">
        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" for="username">Username or Email</label>
          <input 
            type="text" 
            class="form-input" 
            id="username" 
            name="username" 
            placeholder="e.g. alex.smith"
            required 
            autocomplete="username"
          />
        </div>

        <div class="form-group" style="position: relative; margin-bottom: 0;">
          <label class="form-label" for="password">Password</label>
          <input 
            type="password" 
            class="form-input" 
            id="password" 
            name="password" 
            placeholder="Enter your password"
            required 
            autocomplete="current-password"
          />
          <i class="fa-solid fa-eye password-toggle" id="togglePassword"></i>
        </div>

        <div class="flex-between" style="margin: var(--spacing-sm) 0;">
          <label class="flex items-center gap-sm">
            <input type="checkbox" class="form-checkbox">
            <span class="text-sm text-secondary">Remember me</span>
          </label>
          <a href="#" class="text-sm text-primary">Forgot password?</a>
        </div>

        <button type="submit" class="btn btn-primary btn-full btn-lg mt-2">
          Log In
        </button>
      </form>

      <div class="auth-footer">
        <p class="text-secondary">
          Don't have an account? 
          <a href="/users/register" class="text-primary" style="font-weight: 600;">Create one</a>
        </p>
      </div>
    </div>
  </div>

  <!-- Visual Side -->
  <div class="auth-visual-side">
    <div class="visual-graphic">
      <div class="visual-text">Where talent meets<br>opportunity.</div>
      <div class="visual-subtext">A more open, fair, and human<br>hiring process.</div>
    </div>
  </div>
</div>

<script>
  // Password Toggle
  const togglePassword = document.getElementById('togglePassword');
  const password = document.getElementById('password');

  if(togglePassword && password) {
    togglePassword.addEventListener('click', function() {
      const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
      password.setAttribute('type', type);
      
      this.classList.toggle('fa-eye');
      this.classList.toggle('fa-eye-slash');
    });
  }
</script>
