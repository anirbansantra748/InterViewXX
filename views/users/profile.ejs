<% layout("/layouts/boilerplate") %>

<style>
  .profile-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--spacing-xl);
  }

  /* Editorial Header */
  .profile-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-2xl);
    padding-bottom: var(--spacing-xl);
    border-bottom: 1px solid var(--border-color);
  }

  .profile-avatar-large {
    width: 120px;
    height: 120px;
    border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; /* Organic shape */
    background: var(--green-primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    font-weight: 700;
    font-family: var(--font-display);
    flex-shrink: 0;
  }

  .profile-header-info {
    flex: 1;
  }

  .profile-greeting {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    color: var(--green-primary);
    font-weight: 700;
    margin-bottom: var(--spacing-xs);
    letter-spacing: -0.02em;
  }

  .profile-role {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin-bottom: var(--spacing-sm);
  }

  .profile-badges {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
  }

  /* Editorial Layout Grid */
  .dashboard-grid {
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: var(--spacing-2xl);
  }

  @media (max-width: 992px) {
    .dashboard-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Main Column */
  .main-column {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xl);
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--green-primary);
    font-weight: 600;
    margin-bottom: var(--spacing-md);
    border-bottom: 2px solid var(--border-color);
    padding-bottom: var(--spacing-sm);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* Stats Row */
  .stats-row {
    display: flex;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
  }

  .stat-block {
    flex: 1;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
    box-shadow: var(--shadow-sm);
  }

  .stat-block-value {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--green-primary);
    margin-bottom: 4px;
    line-height: 1;
  }

  .stat-block-label {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    font-weight: 500;
  }

  /* Activity List (Applications/Interviews) */
  .activity-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .activity-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-md);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    transition: all 0.2s ease;
  }

  .activity-item:hover {
    border-color: var(--green-action);
    box-shadow: var(--shadow-sm);
  }

  .activity-info h4 {
    margin: 0 0 4px 0;
    font-size: var(--text-base);
    color: var(--green-primary);
  }

  .activity-info p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* Sidebar Column */
  .side-column {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }

  .side-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--spacing-xl);
    box-shadow: var(--shadow-sm);
  }

  .side-card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid var(--border-color);
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .info-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .info-label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    font-weight: 600;
  }

  .info-value {
    font-size: var(--text-base);
    color: var(--text-primary);
  }

  .link-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: var(--bg-tertiary);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .link-pill:hover {
    background: rgba(14, 59, 46, 0.05);
    color: var(--green-primary);
  }
</style>

<div class="profile-container">
  
  <!-- Editorial Header -->
  <header class="profile-header">
    <div class="profile-avatar-large">
      <%= (user.fullName || user.username || 'U')[0].toUpperCase() %>
    </div>
    <div class="profile-header-info">
      <h1 class="profile-greeting">Good morning, <%= user.fullName.split(' ')[0] %></h1>
      <p class="profile-role">
        <%= user.email %> • <%= user.location?.city || 'Planet Earth' %>
      </p>
      <div class="profile-badges">
        <span class="badge badge-primary">
          <%= user.role === 'user' ? 'Candidate' : 'Employer' %>
        </span>
        <% if (user.isAdmin) { %>
          <span class="badge badge-warning">Admin</span>
        <% } %>
      </div>
    </div>
  </header>

  <div class="dashboard-grid">
    
    <!-- Main Column (Activities, Apps, Interviews) -->
    <div class="main-column">
      
      <!-- Stats Row -->
      <div class="stats-row">
        <div class="stat-block">
          <div class="stat-block-value"><%= user.appliedJobs?.length || 0 %></div>
          <div class="stat-block-label">Applications</div>
        </div>
        <div class="stat-block">
          <div class="stat-block-value"><%= user.streak || 0 %></div>
          <div class="stat-block-label">Day Streak</div>
        </div>
        <div class="stat-block">
          <div class="stat-block-value"><%= user.totalPoints || 0 %></div>
          <div class="stat-block-label">Total Points</div>
        </div>
      </div>

      <!-- AI Resume Upload Component -->
      <section>
        <div class="section-heading">
          Resume Intelligence
        </div>
        <%- include('./resume-upload-component') %>
      </section>

      <!-- Recent Activity / Applications -->
      <section>
        <div class="section-heading">
          Recent Activity
          <a href="#" class="text-sm font-medium text-primary" style="text-decoration: none;">View all</a>
        </div>
        <div class="activity-list">
          <div class="activity-item">
            <div class="activity-info">
              <h4>Software Engineer Assessment</h4>
              <p>Completed coding challenge • Score: 95/100</p>
            </div>
            <span class="badge badge-success">Passed</span>
          </div>
          <div class="activity-item">
            <div class="activity-info">
              <h4>Frontend Developer at TechNova</h4>
              <p>Application submitted • Under review</p>
            </div>
            <span class="badge badge-primary">In Progress</span>
          </div>
        </div>
      </section>

    </div>

    <!-- Sidebar Column (Profile Info, Links, Saved Jobs) -->
    <div class="side-column">
      
      <div class="side-card">
        <h3>About Me</h3>
        <div class="info-list">
          <div class="info-item">
            <span class="info-label">Location</span>
            <span class="info-value">
              <%= [user.location?.city, user.location?.state, user.location?.country].filter(Boolean).join(', ') || 'Not specified' %>
            </span>
          </div>
          <div class="info-item">
            <span class="info-label">Phone</span>
            <span class="info-value"><%= user.phone || 'Not specified' %></span>
          </div>
          <div class="info-item">
            <span class="info-label">Member Since</span>
            <span class="info-value">September 2026</span>
          </div>
        </div>
      </div>

      <div class="side-card">
        <h3>Portfolio & Links</h3>
        <div class="info-list" style="gap: 8px;">
          <% if (user.portfolioLinks?.github) { %>
            <a href="<%= user.portfolioLinks.github %>" class="link-pill" target="_blank">
              <i class="fab fa-github"></i> GitHub
            </a>
          <% } %>
          <% if (user.portfolioLinks?.linkedin) { %>
            <a href="<%= user.portfolioLinks.linkedin %>" class="link-pill" target="_blank">
              <i class="fab fa-linkedin"></i> LinkedIn
            </a>
          <% } %>
          <% if (user.portfolioLinks?.portfolio) { %>
            <a href="<%= user.portfolioLinks.portfolio %>" class="link-pill" target="_blank">
              <i class="fa-solid fa-globe"></i> Website
            </a>
          <% } %>
          <% if (!user.portfolioLinks?.github && !user.portfolioLinks?.linkedin && !user.portfolioLinks?.portfolio) { %>
            <p class="text-sm text-muted mb-0">No links added yet.</p>
          <% } %>
        </div>
      </div>
      
      <!-- Education Snapshot if available from AI -->
      <% const college = user.resumeExtractedData?.collegeDetails; %>
      <% if (college && college.collegeName) { %>
        <div class="side-card">
          <h3>Education</h3>
          <div class="info-list">
            <div class="info-item">
              <span class="info-label">Institution</span>
              <span class="info-value" style="font-size: 14px;"><%= college.collegeName %></span>
            </div>
            <% if (college.degree) { %>
            <div class="info-item mt-2">
              <span class="info-label">Degree</span>
              <span class="info-value" style="font-size: 14px;"><%= college.degree %> <%= college.branch ? 'in ' + college.branch : '' %></span>
            </div>
            <% } %>
          </div>
        </div>
      <% } %>

    </div>
  </div>
</div>
