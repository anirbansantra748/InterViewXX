<% layout("/layouts/boilerplate") %>

<style>
  .profile-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--spacing-2xl) var(--spacing-lg);
  }

  .profile-hero {
    background: var(--gradient-primary);
    border-radius: var(--radius-xl);
    padding: var(--spacing-3xl);
    text-align: center;
    position: relative;
    overflow: hidden;
    margin-bottom: var(--spacing-2xl);
  }

  .profile-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
    animation: rotate 15s linear infinite;
  }

  @keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .profile-hero-content {
    position: relative;
    z-index: 1;
  }

  .profile-avatar {
    font-size: 6rem;
    margin-bottom: var(--spacing-lg);
    display: inline-block;
    background: rgba(255, 255, 255, 0.2);
    width: 140px;
    height: 140px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--spacing-lg);
    border: 4px solid rgba(255, 255, 255, 0.3);
  }

  .profile-name {
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    color: var(--text-dark);
    margin-bottom: var(--spacing-sm);
  }

  .profile-email {
    color: rgba(17, 17, 17, 0.7);
    font-size: var(--text-lg);
    margin-bottom: var(--spacing-md);
  }

  .profile-badges {
    display: flex;
    gap: var(--spacing-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  .profile-badge {
    padding: var(--spacing-sm) var(--spacing-md);
    background: rgba(255, 255, 255, 0.3);
    color: var(--text-dark);
    border-radius: var(--radius-full);
    font-weight: var(--font-semibold);
    font-size: var(--text-sm);
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .profile-badge.admin {
    background: #fbbf24;
    color: #000;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-2xl);
  }

  .stat-card-profile {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: var(--spacing-xl);
    text-align: center;
    backdrop-filter: blur(10px);
    transition: var(--transition-base);
  }

  .stat-card-profile:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-purple);
    border-color: var(--purple-primary);
  }

  .stat-icon {
    font-size: var(--text-4xl);
    margin-bottom: var(--spacing-md);
  }

  .stat-number {
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin-bottom: var(--spacing-xs);
  }

  .stat-label {
    color: var(--text-muted);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .profile-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: var(--spacing-lg);
  }

  .profile-section {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: var(--spacing-xl);
    backdrop-filter: blur(10px);
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
    padding-bottom: var(--spacing-md);
    border-bottom: 2px solid var(--purple-primary);
  }

  .section-icon {
    font-size: var(--text-2xl);
  }

  .section-title {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0;
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    padding: var(--spacing-sm) 0;
    border-bottom: 1px solid var(--glass-border);
  }

  .info-row:last-child {
    border-bottom: none;
  }

  .info-label {
    color: var(--text-muted);
    font-weight: var(--font-medium);
  }

  .info-value {
    color: var(--text-primary);
    text-align: right;
  }

  .link-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .link-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-md);
    background: var(--glass-bg-hover);
    border-radius: var(--radius-md);
    transition: var(--transition-base);
    text-decoration: none;
    color: var(--text-primary);
  }

  .link-item:hover {
    background: var(--purple-primary);
    transform: translateX(8px);
  }

  .link-icon {
    font-size: var(--text-xl);
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .skill-tag {
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--purple-primary);
    color: var(--text-primary);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
  }

  .experience-item,
  .project-item {
    padding: var(--spacing-md);
    background: var(--glass-bg-hover);
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-md);
    border-left: 3px solid var(--purple-primary);
  }

  .item-title {
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    margin-bottom: var(--spacing-xs);
  }

  .item-meta {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--spacing-sm);
  }

  .item-description {
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .empty-state-small {
    text-align: center;
    padding: var(--spacing-xl);
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .profile-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="profile-container">
  <!-- Hero Section -->
  <div class="profile-hero">
    <div class="profile-hero-content">
      <div class="profile-avatar">🧑‍🎓</div>
      <h1 class="profile-name"><%= user.fullName %></h1>
      <p class="profile-email"><%= user.email %></p>
      <p class="profile-email">@<%= user.username %></p>
      <div class="profile-badges">
        <span class="profile-badge">
          <i class="fa-solid fa-user"></i>
          <%= user.role.toUpperCase() %>
        </span>
        <% if (user.isAdmin) { %>
          <span class="profile-badge admin">
            <i class="fa-solid fa-crown"></i>
            ADMIN
          </span>
        <% } %>
      </div>
    </div>
  </div>

  <!-- AI Resume Upload Component -->
  <%- include('./resume-upload-component') %>

  <!-- Quick Stats -->
  <div class="stats-grid">
    <div class="stat-card-profile">
      <div class="stat-icon">📊</div>
      <div class="stat-number"><%= user.level || 1 %></div>
      <div class="stat-label">Level</div>
    </div>
    <div class="stat-card-profile">
      <div class="stat-icon">⭐</div>
      <div class="stat-number"><%= user.totalPoints || 0 %></div>
      <div class="stat-label">Total Points</div>
    </div>
    <div class="stat-card-profile">
      <div class="stat-icon">🔥</div>
      <div class="stat-number"><%= user.streak || 0 %></div>
      <div class="stat-label">Day Streak</div>
    </div>
    <div class="stat-card-profile">
      <div class="stat-icon">✅</div>
      <div class="stat-number"><%= user.appliedJobs?.length || 0 %></div>
      <div class="stat-label">Applied Jobs</div>
    </div>
  </div>

  <!-- Profile Sections Grid -->
  <div class="profile-grid">
    
    <!-- Portfolio Links -->
    <div class="profile-section">
      <div class="section-header">
        <span class="section-icon">🌐</span>
        <h3 class="section-title">Portfolio & Links</h3>
      </div>
      <div class="link-list">
        <% if (user.portfolioLinks?.github) { %>
          <a href="<%= user.portfolioLinks.github %>" class="link-item" target="_blank">
            <i class="fab fa-github link-icon"></i>
            <span>GitHub Profile</span>
          </a>
        <% } %>
        <% if (user.portfolioLinks?.linkedin) { %>
          <a href="<%= user.portfolioLinks.linkedin %>" class="link-item" target="_blank">
            <i class="fab fa-linkedin link-icon"></i>
            <span>LinkedIn Profile</span>
          </a>
        <% } %>
        <% if (user.portfolioLinks?.portfolio) { %>
          <a href="<%= user.portfolioLinks.portfolio %>" class="link-item" target="_blank">
            <i class="fa-solid fa-globe link-icon"></i>
            <span>Portfolio Website</span>
          </a>
        <% } %>
        <% if (!user.portfolioLinks?.github && !user.portfolioLinks?.linkedin && !user.portfolioLinks?.portfolio) { %>
          <div class="empty-state-small">
            <p>No portfolio links added yet</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Basic Info -->
    <div class="profile-section">
      <div class="section-header">
        <span class="section-icon">👤</span>
        <h3 class="section-title">Basic Information</h3>
      </div>
      <div class="info-row">
        <span class="info-label">Date of Birth</span>
        <span class="info-value"><%= user.dob ? new Date(user.dob).toLocaleDateString() : 'N/A' %></span>
      </div>
      <div class="info-row">
        <span class="info-label">Gender</span>
        <span class="info-value"><%= user.gender || 'N/A' %></span>
      </div>
      <div class="info-row">
        <span class="info-label">Phone</span>
        <span class="info-value"><%= user.phone || 'N/A' %></span>
      </div>
      <div class="info-row">
        <span class="info-label">Location</span>
        <span class="info-value">
          <%= [user.location?.city, user.location?.state, user.location?.country].filter(Boolean).join(', ') || 'N/A' %>
        </span>
      </div>
      <div class="info-row">
        <span class="info-label">Last Solved</span>
        <span class="info-value"><%= user.lastSolvedDate ? new Date(user.lastSolvedDate).toLocaleDateString() : 'N/A' %></span>
      </div>
    </div>

    <!-- College Info -->
    <% const college = user.resumeExtractedData?.collegeDetails || {}; %>
    <div class="profile-section">
      <div class="section-header">
        <span class="section-icon">🎓</span>
        <h3 class="section-title">Education</h3>
      </div>
      <div class="info-row">
        <span class="info-label">College</span>
        <span class="info-value"><%= college.collegeName || 'N/A' %></span>
      </div>
      <div class="info-row">
        <span class="info-label">Degree</span>
        <span class="info-value"><%= college.degree || 'N/A' %></span>
      </div>
      <div class="info-row">
        <span class="info-label">Duration</span>
        <span class="info-value"><%= college.startYear || 'N/A' %> - <%= college.endYear || 'N/A' %></span>
      </div>
      <div class="info-row">
        <span class="info-label">CGPA</span>
        <span class="info-value"><%= college.cgpa || 'N/A' %></span>
      </div>
    </div>

    <!-- Skills -->
    <% const skills = user.resumeExtractedData?.skills || []; %>
    <div class="profile-section">
      <div class="section-header">
        <span class="section-icon">💻</span>
        <h3 class="section-title">Technical Skills</h3>
      </div>
      <% if (skills.length > 0) { %>
        <div class="skill-tags">
          <% skills.forEach(skill => { %>
            <span class="skill-tag"><%= skill %></span>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state-small">
          <p>No skills listed yet</p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Experience Section (Full Width) -->
  <% if (user.resumeExtractedData?.experience?.length > 0) { %>
    <div class="profile-section" style="margin-top: var(--spacing-lg);">
      <div class="section-header">
        <span class="section-icon">💼</span>
        <h3 class="section-title">Work Experience</h3>
      </div>
      <% user.resumeExtractedData.experience.forEach(exp => { %>
        <div class="experience-item">
          <div class="item-title"><%= exp.position %> @ <%= exp.company %></div>
          <div class="item-meta">
            <%= exp.type %> • <%= exp.mode %> • <%= exp.startDate %> - <%= exp.endDate %>
          </div>
          <div class="item-description"><%= exp.description %></div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <!-- Projects Section (Full Width) -->
  <% if (user.resumeExtractedData?.projects?.length > 0) { %>
    <div class="profile-section" style="margin-top: var(--spacing-lg);">
      <div class="section-header">
        <span class="section-icon">🚀</span>
        <h3 class="section-title">Projects</h3>
      </div>
      <% user.resumeExtractedData.projects.forEach(p => { %>
        <div class="project-item">
          <div class="item-title"><%= p.title %></div>
          <div class="item-meta"><%= p.technologies?.join(', ') || '' %></div>
          <div class="item-description"><%= p.description %></div>
          <div style="margin-top: var(--spacing-sm); display: flex; gap: var(--spacing-md);">
            <% if (p.links?.github) { %>
              <a href="<%= p.links.github %>" class="text-purple" target="_blank">
                <i class="fab fa-github"></i> GitHub
              </a>
            <% } %>
            <% if (p.links?.liveSite) { %>
              <a href="<%= p.links.liveSite %>" class="text-purple" target="_blank">
                <i class="fa-solid fa-external-link-alt"></i> Live Demo
              </a>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <!-- Certifications -->
  <% if (user.resumeExtractedData?.certifications?.length > 0) { %>
    <div class="profile-section" style="margin-top: var(--spacing-lg);">
      <div class="section-header">
        <span class="section-icon">📚</span>
        <h3 class="section-title">Certifications</h3>
      </div>
      <div class="link-list">
        <% user.resumeExtractedData.certifications.forEach(cert => { %>
          <a href="<%= cert.link %>" class="link-item" target="_blank">
            <i class="fa-solid fa-certificate link-icon"></i>
            <span><%= cert.title %></span>
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>
</div>
 
