<% layout("/layouts/boilerplate") %>

<style>
  .auth-split-layout {
    display: flex;
    min-height: calc(100vh - 72px);
    width: 100%;
  }

  .auth-form-side {
    flex: 1;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: var(--spacing-3xl) var(--spacing-xl);
    background: var(--bg-primary);
    overflow-y: auto;
  }

  .auth-visual-side {
    flex: 1;
    display: none;
    background: var(--bg-tertiary);
    position: sticky;
    top: 72px;
    height: calc(100vh - 72px);
    align-items: center;
    justify-content: center;
    padding: var(--spacing-3xl);
  }

  @media (min-width: 992px) {
    .auth-visual-side {
      display: flex;
    }
  }

  .auth-card-inner {
    width: 100%;
    max-width: 600px;
    animation: fadeInUp 0.5s ease-out;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .auth-header {
    margin-bottom: var(--spacing-2xl);
  }

  .auth-title {
    font-size: var(--text-4xl);
    color: var(--green-primary);
    margin-bottom: var(--spacing-sm);
  }

  .auth-subtitle {
    color: var(--text-secondary);
    font-size: var(--text-base);
  }

  .form-section {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--spacing-xl);
    margin-bottom: var(--spacing-lg);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--green-primary);
    margin-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--border-color);
    padding-bottom: var(--spacing-sm);
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-md);
  }

  /* Visual side graphic */
  .visual-graphic {
    position: relative;
    width: 100%;
    max-width: 500px;
    aspect-ratio: 1;
    background: var(--bg-secondary);
    border-radius: 100px 30px 100px 30px; /* Organic shape */
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--spacing-2xl);
  }
  
  .visual-graphic::after {
    content: '';
    position: absolute;
    bottom: -20px;
    left: -20px;
    width: 120px;
    height: 120px;
    background: rgba(34, 197, 94, 0.2);
    border-radius: 50%;
    z-index: -1;
  }

  .visual-text {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--green-primary);
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: var(--spacing-md);
  }
  
  .visual-subtext {
    color: var(--text-secondary);
    font-size: var(--text-lg);
  }
</style>

<div class="auth-split-layout">
  <!-- Form Side -->
  <div class="auth-form-side hide-scrollbar">
    <div class="auth-card-inner">
      <div class="auth-header">
        <h1 class="auth-title">Create your account.</h1>
        <p class="auth-subtitle">Join Hireska to find your next great opportunity or the perfect candidate.</p>
      </div>

      <form action="/users/register" method="POST" enctype="multipart/form-data">
        
        <!-- Basic Information -->
        <div class="form-section">
          <div class="section-title">Basic Information</div>
          <div class="form-grid">
            <div class="form-group mb-0">
              <label class="form-label" for="fullName">Full Name</label>
              <input type="text" class="form-input" id="fullName" name="fullName" placeholder="Jane Doe" required />
            </div>
            <div class="form-group mb-0">
              <label class="form-label" for="username">Username</label>
              <input type="text" class="form-input" id="username" name="username" placeholder="janedoe" required />
            </div>
            <div class="form-group mb-0">
              <label class="form-label" for="email">Email</label>
              <input type="email" class="form-input" id="email" name="email" placeholder="jane@example.com" required />
            </div>
            <div class="form-group mb-0">
              <label class="form-label" for="password">Password</label>
              <input type="password" class="form-input" id="password" name="password" placeholder="Create password" required />
            </div>
            <div class="form-group mb-0" style="grid-column: 1 / -1;">
              <label class="form-label" for="role">Account Type</label>
              <select class="form-select" id="role" name="role">
                <option value="user">Candidate</option>
                <option value="recruiter">Employer / Recruiter</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Personal Details -->
        <div class="form-section">
          <div class="section-title">Personal Details</div>
          <div class="form-grid">
            <div class="form-group mb-0">
              <label class="form-label" for="dob">Date of Birth</label>
              <input type="date" class="form-input" id="dob" name="dob" />
            </div>
            <div class="form-group mb-0">
              <label class="form-label" for="gender">Gender</label>
              <select class="form-select" id="gender" name="gender">
                <option value="">Select gender</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="form-group mb-0">
              <label class="form-label" for="phone">Phone Number</label>
              <input type="tel" class="form-input" id="phone" name="phone" placeholder="+1 (555) 000-0000" />
            </div>
          </div>
        </div>

        <!-- Location -->
        <div class="form-section">
          <div class="section-title">Location</div>
          <div class="form-grid">
            <div class="form-group mb-0">
              <label class="form-label" for="city">City</label>
              <input type="text" class="form-input" id="city" name="address[city]" placeholder="San Francisco" />
            </div>
            <div class="form-group mb-0">
              <label class="form-label" for="state">State</label>
              <input type="text" class="form-input" id="state" name="address[state]" placeholder="CA" />
            </div>
            <div class="form-group mb-0">
              <label class="form-label" for="country">Country</label>
              <input type="text" class="form-input" id="country" name="address[country]" placeholder="United States" />
            </div>
          </div>
        </div>

        <!-- Resume & Avatar -->
        <div class="form-section">
          <div class="section-title">Uploads</div>
          <div class="form-group">
            <label class="form-label" for="resume">Resume (PDF)</label>
            <input type="file" class="form-input" id="resume" name="resume" accept="application/pdf" />
            <p class="text-xs text-muted mt-1">Our AI will automatically extract your skills and experience.</p>
          </div>
          <div class="form-group mb-0">
            <label class="form-label" for="avatar">Profile Photo</label>
            <input type="file" class="form-input" id="avatar" name="avatar" accept="image/*" />
          </div>
        </div>

        <div class="mt-4">
          <button class="btn btn-primary btn-full btn-lg" type="submit">Complete Registration</button>
        </div>
        
        <div class="text-center mt-3">
          <p class="text-secondary">
            Already have an account? <a href="/users/login" class="text-primary" style="font-weight: 600;">Log in</a>
          </p>
        </div>
      </form>
    </div>
  </div>

  <!-- Visual Side -->
  <div class="auth-visual-side">
    <div class="visual-graphic">
      <div class="visual-text">A brighter<br>tomorrow.</div>
      <div class="visual-subtext">Join thousands of professionals finding opportunities that match their true potential.</div>
    </div>
  </div>
</div>
